{
  "name": "@yugioh/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env src/db/migrate.ts",
    "cards:import": "node --env-file-if-exists=../.env src/cards.ts",
    "sheets:compile": "node --env-file-if-exists=../.env src/sheets.ts compile",
    "sheets:import": "node --env-file-if-exists=../.env src/sheets.ts import",
    "sheets:export": "node --env-file-if-exists=../.env src/sheets.ts export",
    "judge:eval": "node --env-file-if-exists=../.env src/judge/evals.ts",
    "duel:report": "node --env-file-if-exists=../.env src/matchReport.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@yugioh/engine": "*",
    "@yugioh/shared": "*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-openid-connect": "^3.4.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "oauth2-mock-server": "^9.3.0",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
