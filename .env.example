# Copy to .env and fill in. See docs/accounts.md for the Auth0 setup.

# Public URL of the site (in dev, the Vite server).
BASE_URL=http://localhost:5173
PORT=3000

DATABASE_URL=postgres://yugioh:yugioh@localhost:5432/yugioh

# Long random string; encrypts the login session and signs the guest cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Auth0 application (type: Regular Web Application).
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# The account with this verified email is the admin and is approved automatically.
ADMIN_EMAIL=

# Production (compose.yaml) only: password for the bundled Postgres. compose.yaml sets DATABASE_URL, PORT and
# CARD_IMAGE_DIR itself. Use letters and digits only, since it goes into a URL: openssl rand -hex 16
# POSTGRES_PASSWORD=

# Downloaded card images (defaults to data/card-images in the repository). Keep it on persistent storage.
# CARD_IMAGE_DIR=
