# Copy to .env and fill in. See docs/accounts.md for the Auth0 setup.

# Public URL of the site (in dev, the Vite server).
BASE_URL=http://localhost:5173
PORT=3000

# Dev only; in production DATABASE_URL comes from /srv/secrets/postgres/yugioh.env (see docs/deploy.md).
DATABASE_URL=postgres://yugioh:yugioh@localhost:5432/yugioh

# Long random string; encrypts the login session and signs the guest cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Auth0 application (type: Regular Web Application).
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# The account with this verified email is the admin and is approved automatically.
ADMIN_EMAIL=

# Downloaded card images (defaults to data/card-images in the repository). Keep it on persistent storage.
# CARD_IMAGE_DIR=

# Anthropic API key for the judge (Claude Haiku 5.5) and appeals (Claude Opus 5.5). Without it, duels run but card
# effects can't be activated. See docs/effects.md.
ANTHROPIC_API_KEY=
# Optional caps on model calls per duel (defaults shown).
# JUDGE_CALLS_PER_DUEL=300
# APPEALS_PER_DUEL=10
# The AI opponent the admin can play against (docs/ai-opponent.md): its model (needs a price in
# server/src/judge/pricing.ts) and its model calls per duel.
# AI_OPPONENT_MODEL=claude-haiku-5-5
# AI_CALLS_PER_DUEL=400
# How long a response window stays open when the player has nothing to respond with (see docs/chains.md).
# RESPONSE_FLOOR_MS=2000
# Development only: at every start, wipe stored effect sheets, their revisions and players' reports, and reload the
# sheets from server/effect-sheets/ (see docs/effects.md).
# RESET_SHEETS=true
